# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required ---------------------------------------------------------------
# Neo4j refuses to start on a known-default password (see config.py).
NEO4J_PASSWORD=change-me-to-something-long
# Single bearer token gating every /api route; the API 503s if unset.
# Only used when AUTH_ENABLED=true. Leave blank when auth is off.
API_TOKEN=

# Master switch. false = no token required for ANY route, writes included
# (ingest, delete, rebuild). This is safe ONLY because BIND_ADDR keeps the
# ports on loopback, so nothing off this machine can reach the API.
# Set true -- and set API_TOKEN -- if you expose the stack on a network.
AUTH_ENABLED=false

# Only consulted when AUTH_ENABLED=true: serve GET/HEAD/OPTIONS without a
# token while writes still require one.
ALLOW_ANONYMOUS_READS=true

# Host interface the published ports bind to. 127.0.0.1 means only this
# machine can reach the UI and API. Set 0.0.0.0 to expose them -- and set
# ALLOW_ANONYMOUS_READS=false if you do.
BIND_ADDR=127.0.0.1
# Keyed HMAC for redacted config values; ingestion fails closed if unset.
GRAPH_HMAC_KEY=generate-with-openssl-rand-hex-32

# --- Optional ---------------------------------------------------------------
# PAT for cloning private repos from github.com.
GITHUB_TOKEN=
# Comma-separated git hosts ingestion is allowed to clone from.
ALLOWED_GIT_HOSTS=github.com
# Extra browser origins for CORS. Empty is correct when the UI is served by the
# bundled nginx, which proxies /api same-origin.
ADDUCE_CORS_ORIGINS=

# --- Host port mappings -----------------------------------------------------
FRONTEND_PORT=28080
BACKEND_PORT=28000
NEO4J_HTTP_PORT=27474
NEO4J_BOLT_PORT=27687

# --- Tuning -----------------------------------------------------------------
# How many repositories may be in scope at once in the UI. A guardrail against
# rendering an unusable graph; raise it if your repos are small.
MAX_SCOPE_REPOS=10
# Exact nodes shown when one graph group is expanded. Search reaches the rest.
GRAPH_DETAIL_NODE_LIMIT=80
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G
INGEST_WORKERS=2
